<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
	<DataCollectors>
	  <DataCollector friendlyName="XPlat Code Coverage">
		<Configuration>
		  <Format>cobertura</Format>
		  <Include>[WebCycleApi]*,[CycleManager.Services]*,[DataAccessEF]*,[CycleManager.Domain]*</Include>
		  <ExcludeByFile>**/Migrations/*.cs,**/Program.cs,**/*.cshtml</ExcludeByFile>
		</Configuration>
	  </DataCollector>
	</DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
