    @model CreateCompetitorViewModel

    <h2>Nieuwe renner toevoegen aan team </h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CompetitorId" />
                <input type="hidden" asp-for="SeasonYearId" />
                <h4>Nieuwe renner gegevens</h4>
                <div class="form-group mb-2">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                </div>
                <div class="form-group mb-2">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                </div>
                <div class="form-group mb-2">
                        <label asp-for="PcsName" class="control-label"></label>
                        <input asp-for="PcsName" class="form-control" />
                </div>
                <div class="form-group mb-2">
                    <label asp-for="CountryId" class="control-label"></label>
                    <select asp-for="CountryId" class="form-control" asp-items="Model.Countries"></select>
                </div>
                <h4>Team en jaar</h4>
                <div class="form-group mb-2">
                    <label asp-for="TeamYearId" class="control-label"></label>
                    <select asp-for="TeamYearId" class="form-control" asp-items="Model.Teams"></select>
                </div>
                <div>
                    <label>Seizoen</label>
                    <p class="form-control-plaintext">@Model.SeasonYear</p>
                </div>

                 <div class="form-group mb-3">
                    <input asp-for="IsNationalChampion" class="form-check-input" />
                    <label asp-for="IsNationalChampion" class="form-check-label"></label>
                </div>
                <div class="form-group">
                    <input type="submit" value="Maak" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Annuleren</a>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index">Terug naar de lijst</a>
    </div>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    }