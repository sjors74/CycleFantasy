@using WebCycleManager.Models.ViewModel
@model CompetitorEditViewModel
@{
    var ratingsLookup = Model.Ratings.ToDictionary(r => r.RatingCategoryId, r => r);
    var allCategories = Model.RatingCategories
        .Where(c => c.IsActive)
        .OrderBy(c => c.DisplayOrder)
        .Select(c => new 
            { 
                Category = c, 
                Rating = ratingsLookup.TryGetValue(c.RatingCategoryId, out var r) 
                ? r.Rating 
                : (decimal?)null 
            })
            .ToList(); 
    var hasAnyRating = allCategories.Any(x => x.Rating.HasValue);
    const decimal maxRating = 2500m;
}
<form asp-action="Edit">
    <input type="hidden" asp-for="CompetitorId" />

    <div class="row">
        <!-- Linker kolom: Rennergegevens -->
        <div class="col-md-6">
            <h4 class="mb-3">Gegevens renner</h4>
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row mb-3 align-items-center">
                        <label asp-for="FirstName" class="col-sm-4 col-form-label">Voornaam</label>
                        <div class="col-sm-8">
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label asp-for="LastName" class="col-sm-4 col-form-label">Achternaam</label>
                        <div class="col-sm-8">
                            <input asp-for="LastName" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label asp-for="PcsName" class="col-sm-4 col-form-label">PCS naam</label>
                        <div class="col-sm-8">
                            <input asp-for="PcsName" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label asp-for="ScraperName" class="col-sm-4 col-form-label">Scraper naam</label>
                        <div class="col-sm-8">
                            <input asp-for="ScraperName" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label asp-for="CountryId" class="col-sm-4 col-form-label">Land</label>
                        <div class="col-sm-8">
                            <select asp-for="CountryId" class="form-control" asp-items="@(Model.Countries.OrderBy(c => c.Text))"></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rechter kolom: Tabs per jaar / Ratings -->
        <div class="col-md-6">
            <h4 class="mb-3">Per jaar</h4>
            @{
                var years = Model.AvailableYears
                .OrderByDescending(y => y.Year)
                .ToList();
            
                var firstTab = true;
                var firstPane = true;
                var globalIndex = 0;
            }

            <ul class="nav nav-tabs" id="yearTabs" role="tablist">
                @foreach (var year in years)
                {
                    var hasData = Model.CompetitorInTeams
                    .Any(c => c.SeasonYearId == year.SeasonYearId);

                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(hasData && firstTab ? "active" : "") @(hasData ? "" : "disabled")"
                                id="tab-@year.SeasonYearId"
                                data-bs-toggle="tab"
                                data-bs-target="#year-@year.SeasonYearId"
                                type="button"
                                role="tab"
                                @(hasData ? "" : "tabindex=-1 aria-disabled=true")>

                            @year.Year
                        </button>
                    </li>

                    if (hasData)
                    {
                        firstTab = false;
                    }
                }
            </ul>

            <div class="tab-content mt-3">

                @foreach (var year in Model.AvailableYears)
                {
                    var competitors = Model.CompetitorInTeams
                    .Where(c => c.SeasonYearId == year.SeasonYearId)
                    .ToList();

                    if (!competitors.Any())
                    {
                        continue;
                    }

                    <div class="tab-pane fade @(firstPane ? "show active" : "")"
                         id="year-@year.SeasonYearId"
                         role="tabpanel">

                        @foreach (var cit in competitors)
                        {
                            <div class="card mb-3 shadow-sm">
                                <div class="card-body">

                                    <input type="hidden"
                                           name="CompetitorInTeams[@globalIndex].CompetitorInTeamId"
                                           value="@cit.CompetitorInTeamId" />

                                    <input type="hidden"
                                           name="CompetitorInTeams[@globalIndex].TeamYearId"
                                           value="@cit.TeamYearId" />

                                    <input type="hidden"
                                           name="CompetitorInTeams[@globalIndex].SeasonYearId"
                                           value="@cit.SeasonYearId" />

                                    <input type="hidden"
                                           name="CompetitorInTeams[@globalIndex].Year"
                                           value="@cit.Year" />

                                    <input type="hidden"
                                           name="CompetitorInTeams[@globalIndex].TeamName"
                                           value="@cit.TeamName" />

                                    <div class="form-check mb-2">
                                        <input asp-for="CompetitorInTeams[@globalIndex].IsNationalChampion"
                                               class="form-check-input" />

                                        <label class="form-check-label"
                                               asp-for="CompetitorInTeams[@globalIndex].IsNationalChampion">
                                            <i class="bi bi-trophy-fill text-warning"></i>
                                            Nationaal kampioen
                                        </label>
                                    </div>

                                    <div>
                                        <i class="bi bi-people-fill text-primary"></i>
                                        <strong>
                                            @cit.TeamName
                                        </strong>
                                    </div>

                                </div>
                            </div>

                            globalIndex++;
                        }

                    </div>

                    firstPane = false;
                }

            </div>

            <!-- Ratings -->
            @if (hasAnyRating) {
                <div class="mt-4"> 
                    <h4 class="mb-3">Ratings</h4> 
                    
                    <div class="row g-3">
                        
                        @foreach (var item in allCategories)
                        {
                           var color = item.Category.Color ?? "secondary";

                           var percentage = item.Rating.HasValue  
                            ? Math.Min(100, Math.Max(4, (int)Math.Round((item.Rating.Value / maxRating) * 100))) 
                            : 0;
                            <div class="col-md-4 col-6">
                                <div class="border rounded p-2 h-100">

                               <div class="d-flex justify-content-between align-items-center mb-1"> 
                                   <span class="fw-semibold">@item.Category.Name</span> 
                                   
                                   @if (item.Rating.HasValue) 
                                   {
                                       <span class="badge bg-@color">@item.Rating.Value.ToString("0")</span>
                                   } 
                                   else
                                   {
                                       <span class="text-muted fst-italic small">nnb</span>
                                   }
                               </div>

                                    <div class="progress" style="height:5px;"> 
                                        <div class="progress-bar bg-@color" 
                                            style="width:@percentage%;">
                                        </div> 
                                    </div>
                                </div>
                        </div>
                        } 
                     </div> 
                </div> 
            }
        </div>
     </div>

    <!-- Onderste regel: Terug + Opslaan -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <a href="@(Model.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">Terug naar de lijst</a>
        <button type="submit" class="btn btn-primary">Opslaan</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
