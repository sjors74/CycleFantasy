@model TeamEditViewModel

<h3>Bewerk team</h3>
<hr />

<form asp-action="Edit">
    <div class="row">

        <!-- Linkerkant -->
        <div class="col-md-6">
            <h4>Algemene gegevens</h4>

            <input asp-for="TeamId" type="hidden" />

            <div class="mb-2">
                <label asp-for="CurrentTeamName" class="form-label"></label>
                <input asp-for="CurrentTeamName" class="form-control" />
            </div>

            <div class="mb-2">
                <label asp-for="CountryId" class="form-label"></label>
                <select asp-for="CountryId"
                        asp-items="Model.Countries"
                        class="form-select">
                </select>
            </div>

            <div class="mb-2">
                <label asp-for="PcsName" class="form-label"></label>
                <input asp-for="PcsName" class="form-control" />
            </div>
        </div>

        <!-- Rechterkant -->
        <div class="col-md-6">
            <h4>Per jaar</h4>

            <ul class="nav nav-tabs" role="tablist">
                @for (int i = 0; i < Model.TeamYears.Count; i++)
                {
                    <li class="nav-item">
                        <button class="nav-link @(i == 0 ? "active" : "")"
                                data-bs-toggle="tab"
                                data-bs-target="#year-@Model.TeamYears[i].SeasonYearId"
                                type="button">
                            @Model.TeamYears[i].Year
                        </button>
                    </li>
                }
            </ul>

            <div class="tab-content mt-3">
                @for (int i = 0; i < Model.TeamYears.Count; i++)
                {
                    <div class="tab-pane fade @(i == 0 ? "show active" : "")"
                         id="year-@Model.TeamYears[i].SeasonYearId">

                        <input asp-for="TeamYears[i].TeamYearId" type="hidden" />
                        <input asp-for="TeamYears[i].SeasonYearId" type="hidden" />
                        <input asp-for="TeamYears[i].Year" type="hidden" />

                        <div class="mb-2">
                            <label asp-for="TeamYears[i].Name" class="form-label"></label>
                            <input asp-for="TeamYears[i].Name" class="form-control" />
                        </div>

                    </div>
                }
            </div>
        </div>

    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Terug naar de lijst
        </a>

        <button type="submit" class="btn btn-primary">
            Opslaan
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}