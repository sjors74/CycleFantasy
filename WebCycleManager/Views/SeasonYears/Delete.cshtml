@model SeasonYearViewModel

@{
    ViewData["Title"] = "Verwijder jaar";
}

<h3>Verwijder jaar</h3>

<hr />

<p>
    Weet je zeker dat je jaar <strong>@Model.Year</strong> wilt verwijderen?
</p>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" name="id" value="@Model.SeasonYearId" />

    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Verwijderen
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Annuleren
    </a>

</form>