@model SeasonYearViewModel

<input asp-for="SeasonYearId" type="hidden" />

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Year" class="form-label"></label>
    <input asp-for="Year" class="form-control" />
    <span asp-validation-for="Year" class="text-danger"></span>
</div>

<div class="form-check mb-4">
    <input asp-for="Active" class="form-check-input" />
    <label asp-for="Active" class="form-check-label"></label>
</div>

<div class="d-flex gap-2">
    <button type="submit" class="btn btn-success">
        <i class="bi bi-check-circle"></i> Opslaan
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Terug
    </a>
</div>