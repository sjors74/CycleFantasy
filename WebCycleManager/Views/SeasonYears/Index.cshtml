@model IEnumerable<SeasonYearViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Jaren</h3>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Maak nieuw
    </a>
</div>

<br />

<div style="max-height: calc(100vh - 250px); overflow-y:auto;">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Year)</th>
                <th>@Html.DisplayNameFor(model => model.Active)</th>
                <th class="text-end">Acties</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Year)</td>

                    <td>
                        @if (item.Active)
                        {
                            <span class="badge bg-success">Ja</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nee</span>
                        }
                    </td>

                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <a asp-action="Edit"
                               asp-route-id="@item.SeasonYearId"
                               class="btn btn-sm btn-outline-primary"
                               title="Wijzig">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.SeasonYearId"
                               class="btn btn-sm btn-outline-danger"
                               title="Verwijder">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>